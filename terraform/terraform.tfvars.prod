# =============================================================================
# Terraform Variables - Exemplo de Configuração
# =============================================================================
# Copie este arquivo para terraform.tfvars e ajuste os valores conforme necessário

# =============================================================================
# Configurações Gerais
# =============================================================================

project_name = "tech-challenge"
environment  = "dev"
aws_region   = "us-east-1"

# =============================================================================
# Configurações de VPC
# =============================================================================

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# Subnets Privadas (para EKS workers e RDS)
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]

# Subnets Públicas (para NAT Gateway e Load Balancers)
public_subnet_cidrs = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# =============================================================================
# Configurações de EKS
# =============================================================================

enable_eks = true
eks_cluster_version     = "1.29"
eks_node_instance_types = ["t3a.medium"]
eks_node_desired_size   = 1
eks_node_min_size       = 1
eks_node_max_size       = 3
eks_node_disk_size      = 20

# =============================================================================
# Configurações de RDS (se aplicável)
# =============================================================================

rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20
rds_engine_version    = "8.0"
rds_database_name     = "tech_challenge"
rds_username          = "admin"

# =============================================================================
# Tags Adicionais
# =============================================================================

additional_tags = {
  Owner      = "FIAP-Grupo19"
  CostCenter = "TechChallenge"
  Terraform  = "true"
}
